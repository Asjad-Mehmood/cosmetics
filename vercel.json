{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "dist/vercel.js",
      "buildCommand": "node scripts/vercel-build.mjs"
    },
    "storefront": {
      "root": "apps/storefront",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_URL" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "storefront" } }
  ],
  "crons": [{ "path": "/api/v1/cron/daily", "schedule": "0 3 * * *" }]
}
